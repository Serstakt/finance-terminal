+from sqlalchemy.orm import Session
+from ..database.database import SessionLocal
+from backend.database.models import Fi
+from datetime import date
+import PyPDF2
+import io
+import re
+
+async def get_financial_metrics(symbol: str, period_type: str = "quarter") -> list:
+    """Получает финансовые показатели по тикеру"""
+    db = SessionLocal()
+    try:
+        metrics = db.query(FinancialMetrics).filter(
+            FinancialMetrics.symbol == symbol,
+            FinancialMetrics.period_type == period_type
+        ).order_by(FinancialMetrics.period.desc()).all()
+
+        return [
+            {
+                "id": m.id,
+                "period": m.period,
+                "revenue": m.revenue,
+                "net_profit": m.net_profit,
+                "ebitda": m.ebitda,
+                "net_debt": m.net_debt,
+                "total_debt": m.total_debt,
+                "cash": m.cash,
+                "assets": m.assets,
+                "equity": m.equity,
+                "eps": m.eps,
+                "dividends_per_share": m.dividends_per_share,
+                "roe": m.roe,
+                "debt_to_equity": m.debt_to_equity,
+                "report_date": m.report_date.isoformat() if m.report_date else None
+            }
+            for m in metrics
+        ]
+    finally:
+        db.close()
+
+async def extract_text_from_pdf(file_content: bytes) -> str:
+    """Извлекает текст из PDF файла"""
+    try:
+        pdf_file = io.BytesIO(file_content)
+        pdf_reader = PyPDF2.PdfReader(pdf_file)
+
+        text = ""
+        for page in pdf_reader.pages:
+            text += page.extract_text() + "\n"
+
+        return text
+    except Exception as e:
+        raise Exception(f"Ошибка чтения PDF: {str(e)}")
+
+async def save_financial_metrics(symbol: str, period: str, period_type: str, metrics_data: dict, source_file: str = None) -> dict:
+    """Сохраняет финансовые показатели в БД"""
+    db = SessionLocal()
+    try:
+        # Проверяем, есть ли уже запись для этого периода
+        existing = db.query(FinancialMetrics).filter(
+            FinancialMetrics.symbol == symbol,
+            FinancialMetrics.period == period
+        ).first()
+
+        if existing:
+            # Обновляем существующую запись
+            for key, value in metrics_data.items():
+                if hasattr(existing, key):
+                    setattr(existing, key, value)
+            existing.report_date = date.today()
+            existing.source_file = source_file
+        else:
+            # Создаем новую запись
+            new_metric = FinancialMetrics(
+                symbol=symbol,
+                period=period,
+                period_type=period_type,
+                report_date=date.today(),
+                source_file=source_file,
+                **metrics_data
+            )
+            db.add(new_metric)
+
+        db.commit()
+        return {"status": "success", "message": "Данные сохранены"}
+    except Exception as e:
+        db.rollback()
+        raise Exception(f"Ошибка сохранения: {str(e)}")
+    finally:
+        db.close()
+
+async def get_all_symbols_with_metrics() -> list:
+    """Получает список всех тикеров, для которых есть финансовые данные"""
+    db = SessionLocal()
+    try:
+        symbols = db.query(FinancialMetrics.symbol).distinct().all()
+        return [s[0] for s in symbols]
+    finally:
+        db.close()
